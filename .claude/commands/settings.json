{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat .specify/constitution.md && echo '---' && git branch --show-current"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .specify/scripts/check-task-alignment.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Before stopping: Are all checkpoints in tasks.md validated? Is spec.md still aligned with implementation?"
          }
        ]
      }
    ]
  }
}
